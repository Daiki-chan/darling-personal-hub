YOUTUBE_API_KEY=

# Upstash Redis REST API (Production Rate Limit & Distributed Cache)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Optional Vercel KV REST API fallback
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# IP Hashing Salt for Rate Limiting
RATE_LIMIT_IP_SALT=your_secret_ip_salt_here

# Supabase Backend Configuration (Database, Auth, Storage, RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
